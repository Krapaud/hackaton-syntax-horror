# Configuration de l'environnement de production
# ATTENTION: Ne pas committer ce fichier avec de vraies valeurs !

# Flask
FLASK_ENV=production
FLASK_APP=app.py

# Sécurité - CHANGEZ CETTE VALEUR EN PRODUCTION !
SECRET_KEY=your-secret-key-change-in-production-use-python-secrets

# Base de données
DATABASE_PATH=data/escape_game.db

# Application
APP_NAME=Syntax Horror
APP_VERSION=1.0.0

# Docker
COMPOSE_PROJECT_NAME=syntax-horror

# Pour générer une clé secrète sécurisée, utilisez Python :
# python -c "import secrets; print(secrets.token_hex(32))"
